# Mock mode is the default and needs no credentials: the whole app - UI,
# OAuth endpoints, data endpoints, tests and demos - runs on the bundled
# mock provider (src/server/providers/mockProvider.ts + src/mock/).
# USE_MOCK and NEXT_PUBLIC_USE_MOCK are aliases for one switch (USE_MOCK
# wins if both disagree). Set either to "false" and restart to switch the
# whole app - UI and endpoints - to the real Google code paths.
USE_MOCK=true
NEXT_PUBLIC_USE_MOCK=true

# Live-backend mode: point the browser at the built-in API route handlers
# for chat, analysis and reports. With "/api" the UI talks to the route
# handlers under src/app/api instead of the client-side mock, while the
# Google provider still follows USE_MOCK above (mock = credential-free).
# Leave unset for the fully client-side mock demo.
# NEXT_PUBLIC_API_BASE_URL=/api

# Real Google mode only (USE_MOCK=false):
# the built-in OAuth endpoints (/api/oauth/google/*) and
# GoogleBusinessProfileProvider need these from a Google Cloud project with
# the Business Profile APIs enabled. Never required to run, test or demo.
# Server-side only; never exposed to the browser.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Persistence (MongoDB, official driver). Unset means the in-memory stores
# with a startup warning; everything still works, data is lost on restart.
# TOKEN_ENCRYPTION_KEY encrypts OAuth tokens at rest (AES-256-GCM); without
# it, sessions stay in memory even when MongoDB is configured.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=branvidia
# TOKEN_ENCRYPTION_KEY=

# LLM client (src/server/llm/). Without LLM_API_KEY the deterministic
# template generator runs, so analysis works end to end with no credentials.
# LLM_PROVIDER=gemini        # openai | anthropic | gemini
# LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash # required for Gemini; no model default in adapter
# LLM_BASE_URL=              # optional OpenAI/Anthropic override; ignored for Gemini
# Never use NEXT_PUBLIC_ for any API key. Restart the host app after changing env.
# LLM_TIMEOUT_MS=8000        # optional, per attempt; default 30000

# Security. Cookie flags; session cookie defaults to Secure on https and
# SameSite=Lax. ALLOWED_ORIGINS adds extra origins for the POST origin check
# (same-origin always allowed). RATE_LIMIT_PER_MINUTE caps /api/chat/* and
# the analysis route per client (default 30).
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax
# ALLOWED_ORIGINS=
# RATE_LIMIT_PER_MINUTE=30
